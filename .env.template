#   gemma2-9b-it
#   mixtral-8x7b-32768               <- good for structured output
#   deepseek-r1-distill-llama-70b
GROQ_API_KEY=your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

