# =============================================================================
# FullMark — Model API Configuration
# =============================================================================
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.
#
# HOW THE FALLBACK CHAIN WORKS
# ─────────────────────────────
# COMPILER_CHAIN is a comma-separated list of provider names.
# FullMark tries them left-to-right; the first that returns a result wins.
# If ALL providers fail or have no key, output is formatted mechanically
# (no LLM) — this always works and requires no API key at all.
#
# RECOMMENDED STARTER CHAIN (all free, no cost):
#   COMPILER_CHAIN=openrouter_free,groq,cerebras,nvidia,gemini,mistral_free,ollama
#
# RECOMMENDED CHAIN (free + low-cost fallback):
#   COMPILER_CHAIN=openrouter_free,groq,cerebras,gemini,deepseek,mistral,ollama
#
# PREMIUM CHAIN (best quality, pay-per-use):
#   COMPILER_CHAIN=anthropic,openai,gemini_pro,openrouter_free,ollama
# =============================================================================

COMPILER_CHAIN=openrouter_free,groq,cerebras,nvidia,gemini,deepseek,mistral_free,ollama

# Warn in logs when no provider is available (set to false to silence)
COMPILER_WARN_ON_LIMIT=true

# =============================================================================
# VISION CHAIN (image description for decorative/human images and empty SVGs)
# =============================================================================
# ROLE: VISION_CHAIN is used when an image has no detectable OCR text (photos,
# illustrations, human portraits, abstract art, complex SVGs with no text).
# FullMark sends the image to a vision-capable LLM and gets a Markdown
# description. If all vision providers fail, falls back to base64 embedding.
#
# Priority order: tries left-to-right, uses the first that responds.
# Only providers with vision support are accepted (others are skipped silently).
#
# Vision-capable providers: gemini, gemini_free, gemini_pro, openai,
#                           anthropic, openrouter_free (on multimodal models)
#
# Local vision via Ollama: set OLLAMA_VISION_MODEL=llava (or llava:13b, llava:34b)
# and add 'ollama' to the chain.
#
# VISION_CHAIN=gemini,openai,anthropic,openrouter_free,ollama  # full chain
VISION_CHAIN=gemini,gemini_free,openai,anthropic,openrouter_free

# Ollama vision model (llava family — must be pulled first: ollama pull llava)
# OLLAMA_VISION_MODEL=llava

# =============================================================================
# OUTPUT SETTINGS
# =============================================================================
OUTPUT_DIR=./output
IMAGE_FORMAT=sequential
EMBED_DECORATIVE_IMAGES=true
SVG_TO_MERMAID=true
AUTO_DOWNLOAD_IMAGES=true

# =============================================================================
# WHISPER SETTINGS (video/audio transcription — fully local, no API key)
# =============================================================================
# ROLE: Whisper is the DEFAULT transcription engine for ALL video and audio
# files (MP4, AVI, MOV, MKV, WEBM, MP3, WAV, M4A).
# It runs entirely on your PC — no internet, no API key, no cost.
# It is NOT used for any other format (PDF, DOCX, images, web, etc.).
#
# HOW IT WORKS:
#   1. VideoAgent extracts the audio track from your video using ffmpeg
#   2. Whisper transcribes the audio into timestamped text segments
#   3. The transcript is combined with frame OCR by CompilerAgent
#   4. Output is a structured Markdown document with [MM:SS] sections
#
# MODEL SIZES — choose based on your hardware:
# (Models are downloaded automatically on first use to ~/.cache/whisper/)
#
#   Model   | Size on disk | VRAM  | Speed (CPU) | Accuracy | Best for
#   ─────────────────────────────────────────────────────────────────────
#   tiny    | ~75MB        | <1GB  | ~32x RT     | Basic    | Fast batch jobs
#   base    | ~145MB       | ~1GB  | ~16x RT     | Good     | Everyday use (DEFAULT)
#   small   | ~465MB       | ~2GB  | ~6x RT      | Better   | Podcasts, meetings
#   medium  | ~1.5GB       | ~5GB  | ~2x RT      | High     | Interviews, lectures
#   large   | ~3GB         | ~10GB | ~1x RT      | Best     | Requires 12GB+ GPU
#   large-v3| ~3GB         | ~10GB | ~1x RT      | Best+    | Latest, most accurate
#
# RT = real-time. 16x means 1hr audio transcribed in ~4 minutes on CPU.
#
# TO SEE WHICH MODELS ARE ALREADY DOWNLOADED ON YOUR PC:
#   Windows: dir %USERPROFILE%\.cache\whisper
#   Linux  : ls ~/.cache/whisper
#
# NOTE: Ollama LLM models also consume GPU VRAM.
#       If running Ollama + Whisper simultaneously on an 8GB GPU:
#         - Use tiny or base Whisper (1GB or less)
#         - Or stop Ollama first: `ollama stop <model>`
WHISPER_MODEL=base

# Optional: override the model cache directory (default: ~/.cache/whisper)
# WHISPER_CACHE_DIR=C:/path/to/your/whisper/models

# =============================================================================
# WEB AGENT SETTINGS
# =============================================================================
WEB_REQUEST_TIMEOUT=30
WEB_USER_AGENT=FullMark/1.0 (+https://github.com/tmprabubiz/fullmark)


# #############################################################################
# TIER 1 - FREE API PROVIDERS
# No cost, rate-limited. Best for most FullMark use cases.
# #############################################################################

# =============================================================================
# OPENROUTER — FREE MODELS  (provider name: openrouter_free)
# =============================================================================
# Portal  : https://openrouter.ai/keys
# Free tier: Unlimited requests on models tagged ":free"
# Why first: Widest selection of free models, automatic routing
#
# Current free models (check https://openrouter.ai/models?q=:free for updates):
#   google/gemini-2.0-flash-exp:free       <- best overall free model
#   google/gemma-3-27b-it:free
#   google/gemma-2-9b-it:free
#   meta-llama/llama-3.3-70b-instruct:free <- best open-source free
#   meta-llama/llama-3.1-8b-instruct:free
#   mistralai/mistral-7b-instruct:free
#   mistralai/mistral-nemo:free
#   deepseek/deepseek-r1:free              <- best reasoning free
#   deepseek/deepseek-v3:free
#   deepseek/deepseek-chat:free
#   qwen/qwen3-235b-a22b:free              <- large MoE, excellent quality
#   qwen/qwen-2-7b-instruct:free
#   nousresearch/hermes-3-llama-3.1-405b:free
#   microsoft/phi-3-mini-128k-instruct:free
#   huggingfaceh4/zephyr-7b-beta:free
#
# OPENROUTER_FREE_MODELS: Comma-separated fallback list.
# FullMark rotates through them if the primary is rate-limited.
OPENROUTER_API_KEY=your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_FREE_MODELS=google/gemini-2.0-flash-exp:free,deepseek/deepseek-r1:free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-235b-a22b:free,mistralai/mistral-7b-instruct:free

