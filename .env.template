# =============================================================================
# OLLAMA — LOCAL MODELS  (provider name: ollama)
# =============================================================================
# Install : https://ollama.com/download
# Pull a model: ollama pull mistral
#
# GPU MEMORY GUIDE (8GB VRAM systems):
# Ollama loads the entire model into VRAM. Running Ollama + Whisper together
# on 8GB VRAM requires careful model selection.
#
#   Model size  | Example models              | VRAM  | Safe with Whisper base?
#   ──────────────────────────────────────────────────────────────────────────
#   ~2B params  | gemma2:2b, qwen2.5:1.5b     | ~1.5GB | YES (comfortable)
#   ~3B params  | phi3:mini, llama3.2:3b       | ~2GB   | YES
#   ~7B params  | mistral, llama3.2, phi3      | ~4-5GB | YES (tight with base)
#   ~13B params | llama3.1:13b                 | ~7-8GB | RISKY (use tiny Whisper)
#   ~30B params | phi4, qwen2.5:32b            | ~18GB  | NO
#   ~70B params | llama3.3:70b, qwen2.5:72b    | ~40GB  | NO
#
# Tip: Use `ollama ps` to see what is loaded in VRAM.
# Tip: Unload a model with `ollama stop <model>` before running Whisper large.
#
# Recommended models by priority:
#   Balanced quality : mistral, phi3, llama3.2:3b
#   Fastest          : phi3:mini, gemma2:2b, qwen2.5:1.5b
#   Best local quality (8GB): phi3:medium, mistral-nemo (unload Whisper first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
# Comma-separated fallback: tried in order if primary model is not installed
OLLAMA_FALLBACK_MODELS=mistral,llama3.2,phi3:mini,gemma2:2b


